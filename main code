import numpy as np
import matplotlib.pyplot as plt

# Параметры нелинейности и системы
beta = 14.286
a, b = -1.143, -0.714
h_step = 0.01
steps = 15000

def h_func(x):
    return b * x + 0.5 * (a - b) * (np.abs(x + 1) - np.abs(x - 1))

def chua(u, alpha):
    x, y, z = u
    return np.array([
        alpha * (y - x - h_func(x)),
        x - y + z,
        -beta * y
    ])

def rk4(u, alpha, dt):
    k1 = chua(u, alpha)
    k2 = chua(u + 0.5 * dt * k1, alpha)
    k3 = chua(u + 0.5 * dt * k2, alpha)
    k4 = chua(u + dt * k3, alpha)
    return u + (dt / 6.0) * (k1 + 2*k2 + 2*k3 + k4)

# Четыре характерных значения alpha
alpha_values = [8.4, 8.8, 8.95, 9.2]
titles = [
    r"$\alpha=8.4$ (Затухание)", 
    r"$\alpha=8.8$ (Предельный цикл)", 
    r"$\alpha=8.95$ (Удвоение периода)", 
    r"$\alpha=9.2$ (Хаос Double Scroll)"
]

fig = plt.figure(figsize=(14, 10))

for idx, alpha_val in enumerate(alpha_values):
    state = np.zeros((steps, 3))
    state[0] = [0.1, 0.0, 0.0]
    
    # Интегрирование
    for i in range(steps - 1):
        state[i+1] = rk4(state[i], alpha_val, h_step)
    
    # Отбрасываем переходный процесс (первые 3000 точек)
    x = state[3000:, 0]
    y = state[3000:, 1]
    z = state[3000:, 2]
    
    # Отрисовка 3D графика
    ax = fig.add_subplot(2, 2, idx + 1, projection='3d')
    ax.plot(x, y, z, lw=0.4, color='crimson' if idx == 3 else 'navy')
    ax.set_title(titles[idx], fontsize=11)
    ax.set_xlabel("x")
    ax.set_ylabel("y")
    ax.set_zlabel("z")

plt.tight_layout()
plt.show()
